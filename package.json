{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "example-project/*"
  ],
  "scripts": {
    "build:stencil": "lerna run build:stencil --workspace=@technway/stencil-library",
    "build:react": "lerna run build --workspace=@technway/react-library",
    "build:next": "lerna run build --workspace=@technway/next-library",
    "build:all": "npm run build:stencil && npm run build:react && npm run build:next",
    "build:layout-kit": "npm run build --workspace=@technway/layout-kit",
    "lint:layout-kit": "npm run lint --workspace=@technway/layout-kit",
    "test:layout-kit": "npm run test --workspace=@technway/layout-kit",
    "react-app": "npm run dev --workspace=react-app"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@types/node": "^22.10.1",
    "husky": "^9.1.7",
    "lerna": "^8.1.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "root": "file:"
  },
  "version": "3.3.0"
}