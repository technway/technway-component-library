{
  "name": "root",
  "private": true,
  "scripts": {
    "sb": "lerna run sb",
    "docs": "pnpm --filter @technway/stencil-library run docs",
    "test:stencil": "pnpm --filter @technway/stencil-library run test.spec",
    "test:stencil:u": "pnpm --filter @technway/stencil-library run test.spec -- -u",
    "build:stencil": "pnpm --filter @technway/stencil-library run build:stencil",
    "build:react": "pnpm --filter @technway/react-library run build",
    "build:next": "pnpm --filter @technway/next-library run build",
    "build:all": "pnpm run build:stencil && pnpm run build:react && pnpm run build:next",
    "build:layout-kit": "pnpm --filter @technway/layout-kit run build",
    "react": "pnpm --filter react-app run dev",
    "next-15": "pnpm --filter next-v15-app run dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@types/node": "^22.10.1",
    "husky": "^9.1.7",
    "lerna": "^8.1.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "root": "file:"
  },
  "version": "3.5.3",
  "packageManager": "pnpm@9.15.3"
}