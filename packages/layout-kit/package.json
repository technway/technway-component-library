{
  "name": "@technway/layout-kit",
  "version": "0.4.0",
  "description": "A lightweight and modular CSS utility framework focused on creating responsive grid systems and flexible layouts for modern web design.",
  "author": "Technway <contact@technway.biz>",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/technway/technway-component-library.git"
  },
  "bugs": {
    "url": "https://github.com/technway/technway-component-library/issues"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js"
    },
    "./react/Grid": {
      "types": "./dist/react/Grid.d.ts",
      "import": "./dist/react/Grid.js",
      "require": "./dist/react/Grid.js"
    },
    "./css": "./dist/css/grid.css",
    "./src/grid.css": "./src/grid.css"
  },
  "scripts": {
    "clean": "rmdir /s /q dist 2>nul || echo Dist directory not found",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "echo \"No tests specified for layout-kit\" && exit 0",
    "type-check": "tsc --noEmit",
    "build:ts": "tsc -p tsconfig.json",
    "build:css": "postcss src/**/*.css --config postcss.config.ts --dir dist/css",
    "build:react": "tsc -p tsconfig.json --outDir dist",
    "build": "npm run clean && npm run lint && npm run type-check && npm run build:ts && npm run build:css && npm run build:react && npm run copy:assets",
    "copy:assets": "mkdir dist\\src && xcopy /E /I src dist\\src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "cssnano": "^7.0.6",
    "eslint": "^8.49.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^10.1.3",
    "typescript": "~5.3.3"
  },
  "gitHead": "2b09600f0a902db7a8a4d8110f947242581d52e6"
}
