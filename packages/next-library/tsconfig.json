{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "baseUrl": ".",
        "outDir": "src",
        "lib": [
            "dom",
            "es2015"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "es2015",
        "skipLibCheck": true,
        "jsx": "react",
        "allowSyntheticDefaultImports": true,
        "declarationDir": "dist/types"
    },
    "include": [
        "src",
        "dist/types"
    ],
    "exclude": [
        "node_modules"
    ]
}