{
  "name": "@technway/stencil-library",
  "version": "2.2.0",
  "description": "A modular web component library built with Stencil.js, providing reusable, customizable components for scalable UI development across multiple frameworks.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.mjs",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/stencil-library/stencil-library.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.mjs"
    },
    "./hydrate": {
      "types": "./hydrate/index.d.ts",
      "import": "./hydrate/index.js",
      "require": "./hydrate/index.cjs.js",
      "default": "./hydrate/index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.js",
      "default": "./loader/index.js"
    },
    "./components/*": {
      "types": "./dist/types/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./components/*.js": {
      "types": "./dist/types/components/*.d.ts",
      "import": "./components/*.js"
    },
    "./components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.js"
    },
    "./stencil-library.css": {
      "default": "./dist/stencil-library/stencil-library.css"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ionic-team/stencil-component-starter.git"
  },
  "files": [
    "dist/",
    "loader/",
    "hydrate/",
    "components/"
  ],
  "scripts": {
    "clean": "rmdir /s /q dist components stencil hydrate loader 2>nul || echo Directories not found",
    "build:all": "npm run g:css-utils && stencil build",
    "build:sb": "storybook build",
    "build:stencil": "stencil build --docs",
    "build:react": "stencil build --react",
    "build:components-css-utils": "node scripts/build-components-css-utils.mjs",
    "watch": "concurrently \"npm run g:css-utils\" \"stencil build --watch\"",
    "watch:stencil": "stencil build --watch",
    "watch:docs": "concurrently \"npm run g:components-mdx\"",
    "watch:css-utils": "nodemon --watch src/globals/utils.pcss --exec \"npm run g:css-utils\"",
    "dev:all": "concurrently \"npm run g:css-utils\" \"stencil build --dev --watch --serve\"",
    "dev:stencil": "stencil build --dev --watch --serve",
    "test.spec": "stencil test --spec",
    "test.spec:single": "stencil test --spec --",
    "test.coverage": "stencil test --spec --coverage --",
    "test.e2e": "npx playwright test",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "docs:catalog": "node scripts/generate-components-catalog.mjs",
    "docs": "stencil docs && npm run docs:catalog && npm run g:components-mdx all",
    "sb": "storybook dev -p 6006",
    "start": "node api/index.ts",
    "deploy": "vercel --prod",
    "chromatic": "env-cmd -f ./.env node -e \"require('child_process').execSync('chromatic --project-token ' + process.env.CHROMATIC_PROJECT_TOKEN + ' --exit-zero-on-changes', { stdio: 'inherit' })\"",
    "g:css-utils": "node scripts/generate-responsive-css-utils.mjs",
    "g:component": "stencil generate",
    "g:components-stories": "node scripts/generate-stories.mjs",
    "g:components-usage": "node scripts/generate-components-usage.mjs",
    "g:components-mdx": "node scripts/generate-components-mdx.mjs",
    "g:components-validations": "node scripts/validate-components-props.mjs",
    "g:components-css-utils": "node scripts/generate-components-css-utils.mjs",
    "lint": "eslint src/**/*{.ts,.tsx}",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "genPackagelock": "npm i --package-lock-only"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.9.0",
    "@etchteam/storybook-addon-status": "^5.0.0",
    "@playwright/test": "^1.48.2",
    "@stencil-community/eslint-plugin": "^0.8.0",
    "@stencil-community/postcss": "^2.2.0",
    "@stencil/core": "4.23.0",
    "@stencil/playwright": "^0.2.1",
    "@stencil/react-output-target": "^0.8.2",
    "@stencil/store": "^2.0.16",
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/addon-interactions": "^8.3.0",
    "@storybook/addon-links": "^8.3.0",
    "@storybook/addon-themes": "^8.3.0",
    "@storybook/addon-webpack5-compiler-swc": "^1.0.5",
    "@storybook/blocks": "^8.3.0",
    "@storybook/html": "^8.3.0",
    "@storybook/html-webpack5": "^8.3.0",
    "@storybook/manager-api": "^8.3.0",
    "@storybook/test": "^8.3.0",
    "@types/jest": "^29.5.6",
    "@types/node": "^22.5.5",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "dotenv-cli": "^7.4.2",
    "env-cmd": "^10.1.0",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "npm": "^10.8.3",
    "postcss": "^8.4.49",
    "postcss-each": "^1.1.0",
    "postcss-for": "^2.1.1",
    "postcss-import": "^16.1.0",
    "postcss-mixins": "^11.0.1",
    "postcss-nested": "^6.2.0",
    "postcss-preset-env": "^10.0.3",
    "puppeteer": "^24.0.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "storybook": "^8.3.0",
    "storybook-addon-preview": "^2.3.0",
    "storybook-addon-rtl": "^1.0.1"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@technway/stencil-library": "file:",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0"
  },
  "gitHead": "972403539a63cd2162ef52cd170a48b91dd26d59"
}
