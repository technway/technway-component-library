/* Focus styles */
.tnw-button:focus-visible {
    outline: var(--tnw-button-focus-ring-width) solid var(--tnw-button-focus-ring-color);
    outline-offset: var(--tnw-button-focus-ring-offset);
}

/* For browsers that don't support :focus-visible */
.tnw-button:focus:not(:focus-visible) {
    outline: none;
}

/* Add focus ring color variants */
:host(.tnw-extended-v-solid-primary) .tnw-button:focus-visible {
    --tnw-button-focus-ring-color: var(--tnw-primary-color);
}

:host(.tnw-extended-v-solid-secondary) .tnw-button:focus-visible {
