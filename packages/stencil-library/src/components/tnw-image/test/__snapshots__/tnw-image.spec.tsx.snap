exports[`tnw-image Custom Prop Behavior renders caption when caption prop is provided 1`] = `
<tnw-image alt="Image with Caption" caption="This is a caption" class="tnw-image--width-full" src="https://example.com/image.jpg">
  <template shadowrootmode="open">
    <figure class="tnw-image__figure" part="figure">
      <img alt="Image with Caption" class="rounded-default tnw-image" loading="eager" part="image" src="https://example.com/image.jpg">
      <figcaption class="tnw-image__figure-caption" part="figcaption">
        This is a caption
      </figcaption>
    </figure>
  </template>
</tnw-image>
`;

