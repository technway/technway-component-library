<tnw-list list-data="{&quot;listTag&quot;:&quot;ul&quot;,&quot;markerType&quot;:&quot;circle&quot;,&quot;items&quot;:[{&quot;text&quot;:&quot;Introduction&quot;,&quot;iconName&quot;:&quot;tnw-folder&quot;,&quot;url&quot;:&quot;https://example.com/introduction&quot;,&quot;newTab&quot;:true,&quot;subList&quot;:{&quot;listTag&quot;:&quot;ol&quot;,&quot;markerType&quot;:&quot;decimal&quot;,&quot;items&quot;:[{&quot;text&quot;:&quot;What is a list?&quot;},{&quot;text&quot;:&quot;How to use it&quot;}]}},{&quot;text&quot;:&quot;Conclusion&quot;,&quot;iconName&quot;:&quot;tnw-folder&quot;}]}">
  <template shadowrootmode="open">
    <style>
      * {
    box-sizing: border-box;
}
    
:host {
    display: block;
    --tnw-list-font: var(--tnw-font-text);
}

.tnw-list {
    list-style-type: none;
    margin: 0;
    padding: 0;
}
.tnw-list--disc,
tnw-list__sub-list--disc {
    list-style-type: disc;
}
.tnw-list--circle,
tnw-list__sub-list--circle {
    list-style-type: circle;
}
.tnw-list--square,
tnw-list__sub-list--square {
    list-style-type: square;
}
.tnw-list--decimal,
tnw-list__sub-list--decimal {
    list-style-type: decimal;
}
.tnw-list--lower-roman,
tnw-list__sub-list--lower-roman {
    list-style-type: lower-roman;
}
.tnw-list--upper-roman,
tnw-list__sub-list--upper-roman {
    list-style-type: upper-roman;
}

.tnw-list--inside,
tnw-list__sub-list--inside {
    list-style-position: inside;
}
.tnw-list--outside,
tnw-list__sub-list--outside {
    list-style-position: outside;
}

/*.tnw-list__icon {
    margin-inline-end: var(--tnw-spacing-xs);
