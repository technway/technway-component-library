.tnw-portfolio-grid__content {
    display: grid;
    grid-template-rows: auto auto;
}

.tnw-portfolio-grid__content--gradient-fade {
    position: relative;
}
.tnw-portfolio-grid__content--gradient-fade::after {
    content: '';
