.tnw-v {
  /*
    * none
    */
  &-none {
    border: 0 !important;
    background: none !important;
    padding: 0 !important;
  }

  /*
    * transparent
    */
  &-transparent {
    &-primary {
      color: var(--tnw-primary-color);
      fill: var(--tnw-primary-color);
    }
    &-secondary {
      color: var(--tnw-secondary-color);
      fill: var(--tnw-secondary-color);
    }
    &-auto {
      color: var(--tnw-text-color);
      fill: var(--tnw-text-color);
    }
    &-inverse {
      color: var(--tnw-text-color-inverse);
      fill: var(--tnw-text-color-inverse);
    }
    &-light {
      color: var(--tnw-text-color-light);
      fill: var(--tnw-text-color-light);
    }
    &-white {
      color: var(--tnw-white);
      fill: var(--tnw-white);
    }
    &-black {
      color: var(--tnw-black);
      fill: var(--tnw-black);
    }
  }

  /*
    * solid
    */
  &-solid {
    &-primary,
    &-secondary,
    &-black {
      color: var(--tnw-white);
      fill: var(--tnw-white);
    }

    &-light,
    &-auto {
      color: var(--tnw-text-color);
      fill: var(--tnw-text-color);
    }

    &-primary {
      background-color: var(--tnw-primary-color);
    }
    &-secondary {
      background-color: var(--tnw-secondary-color);
    }
    &-auto {
      background-color: var(--tnw-background-color);
    }
    &-inverse {
      background-color: var(--tnw-background-color-inverse);
      color: var(--tnw-text-color-inverse);
      fill: var(--tnw-text-color-inverse);
    }
    &-light {
      background-color: var(--tnw-background-color-secondry);
    }
    &-white {
      background-color: var(--tnw-white);
      color: var(--tnw-black);
      fill: var(--tnw-black);
    }
    &-black {
      background-color: var(--tnw-black);
    }
  }

  /*
    * Mixed
    */
  &-mixed {
    &-primary,
    &-secondary,
    &-black,
    &-white,
    &-light,
    &-auto {
      border-width: var(--tnw-border-sm);
      border-style: solid;
    }

    &-primary {
      background-color: var(--tnw-primary-color-100);
      border-color: var(--tnw-primary-color-200);
    }
    &-secondary {
      background-color: var(--tnw-secondary-color-100);
      border-color: var(--tnw-secondary-color-200);
    }
    &-auto {
      background-color: var(--tnw-background-color-100);
      border-color: var(--tnw-background-color-200);
    }
    &-inverse {
      background-color: var(--tnw-background-color-inverse-100);
      border-color: var(--tnw-background-color-inverse-200);
      color: var(--tnw-text-color-inverse);
      fill: var(--tnw-text-color-inverse);
    }
    &-light {
      background-color: var(--tnw-background-color-100);
      border-color: var(--tnw-background-color-200);
    }
    &-white {
      background-color: var(--tnw-gray-100);
      border-color: var(--tnw-gray-300);
    }
    &-black {
      background-color: var(--tnw-gray-800);
      border-color: var(--tnw-gray-900);
    }
  }

  /*
    * outline
    */
  &-outlined {
    &-primary,
    &-secondary,
    &-auto,
    &-inverse,
    &-light,
    &-white,
    &-black {
      border-width: var(--tnw-border-sm);
      border-style: solid;
    }

    &-primary {
      border-color: var(--tnw-primary-color);
    }
    &-secondary {
      border-color: var(--tnw-secondary-color);
    }
    &-auto {
      border-color: var(--tnw-border-color);
    }
    &-inverse {
      border-color: var(--tnw-border-color-inverse);
    }
    &-light {
      border-color: var(--tnw-border-color-opacity);
    }
    &-white {
      border-color: var(--tnw-white);
    }
    &-black {
      border-color: var(--tnw-black);
    }
  }
}

.tnw-extended-v {
  /*
    * none
    */
  &-none {
    border: 0 !important;
    background: none !important;
    padding: 0 !important;
  }

  /*
    * transparent
    */
  &-transparent {
    &-primary {
      color: var(--tnw-primary-color);
      fill: var(--tnw-primary-color);
    }
    &-secondary {
      color: var(--tnw-secondary-color);
      fill: var(--tnw-secondary-color);
    }
    &-auto {
      color: var(--tnw-text-color);
      fill: var(--tnw-text-color);
    }
    &-inverse {
      color: var(--tnw-text-color-inverse);
      fill: var(--tnw-text-color-inverse);
    }
    &-light {
      color: var(--tnw-text-color-light);
      fill: var(--tnw-text-color-light);
    }
    &-white {
      color: var(--tnw-white);
      fill: var(--tnw-white);
    }
    &-black {
      color: var(--tnw-black);
      fill: var(--tnw-black);
    }
    &-success {
      color: var(--tnw-success-color);
      fill: var(--tnw-success-color);
    }
    &-warning {
      color: var(--tnw-warning-color);
      fill: var(--tnw-warning-color);
    }
    &-danger {
      color: var(--tnw-danger-color);
      fill: var(--tnw-danger-color);
    }
    &-info {
      color: var(--tnw-info-color);
      fill: var(--tnw-info-color);
    }
  }

  /*
    * solid
    */
  &-solid {
    &-primary,
    &-secondary,
    &-black {
      color: var(--tnw-white);
      fill: var(--tnw-white);
    }

    &-success,
    &-warning,
    &-info,
    &-danger,
    &-white {
      color: var(--tnw-black);
      fill: var(--tnw-black);
    }

    &-light,
    &-auto {
      color: var(--tnw-text-color);
      fill: var(--tnw-text-color);
    }

    &-primary {
      background-color: var(--tnw-primary-color);
    }
    &-secondary {
      background-color: var(--tnw-secondary-color);
    }
    &-auto {
      background-color: var(--tnw-background-color);
    }
    &-inverse {
      background-color: var(--tnw-background-color-inverse);
      color: var(--tnw-text-color-inverse);
      fill: var(--tnw-text-color-inverse);
    }
    &-light {
      background-color: var(--tnw-background-color-secondry);
    }
    &-white {
      background-color: var(--tnw-white);
    }
    &-black {
      background-color: var(--tnw-black);
    }
    &-success {
      background-color: var(--tnw-success-color-100);
    }
    &-warning {
      background-color: var(--tnw-warning-color-100);
    }
    &-danger {
      background-color: var(--tnw-danger-color-100);
    }
    &-info {
      background-color: var(--tnw-info-color-100);
    }
  }

  /*
    * Mixed
    */
  &-mixed {
    &-primary,
    &-secondary,
    &-black,
    &-success,
    &-warning,
    &-info,
    &-danger,
    &-white,
    &-light,
    &-auto {
      border-width: var(--tnw-border-sm);
      border-style: solid;
    }

    &-primary {
      background-color: var(--tnw-primary-color-100);
      border-color: var(--tnw-primary-color-200);
    }
    &-secondary {
      background-color: var(--tnw-secondary-color-100);
      border-color: var(--tnw-secondary-color-200);
    }
    &-auto {
      background-color: var(--tnw-background-color-100);
      border-color: var(--tnw-background-color-200);
    }
    &-inverse {
      background-color: var(--tnw-background-color-inverse-100);
      border-color: var(--tnw-background-color-inverse-200);
      color: var(--tnw-text-color-inverse);
      fill: var(--tnw-text-color-inverse);
    }
    &-light {
      background-color: var(--tnw-background-color-100);
      border-color: var(--tnw-background-color-200);
    }
    &-white {
      background-color: var(--tnw-gray-100);
      border-color: var(--tnw-gray-300);
    }
    &-black {
      background-color: var(--tnw-gray-800);
      border-color: var(--tnw-gray-900);
    }
    &-success {
      background-color: var(--tnw-success-color-200);
      border-color: var(--tnw-success-color-100);
    }
    &-warning {
      background-color: var(--tnw-warning-color-200);
      border-color: var(--tnw-warning-color-100);
    }
    &-danger {
      background-color: var(--tnw-danger-color-200);
      border-color: var(--tnw-danger-color-100);
    }
    &-info {
      background-color: var(--tnw-info-color-200);
      border-color: var(--tnw-info-color-100);
    }
  }

  /*
    * outline
    */
  &-outlined {
    &-primary,
    &-secondary,
    &-auto,
    &-inverse,
    &-light,
    &-white,
    &-black,
    &-success,
    &-warning,
    &-danger,
    &-info {
      border-width: var(--tnw-border-sm);
      border-style: solid;
    }

    &-primary {
      border-color: var(--tnw-primary-color);
    }
    &-secondary {
      border-color: var(--tnw-secondary-color);
    }
    &-auto {
      border-color: var(--tnw-border-color);
    }
    &-inverse {
      border-color: var(--tnw-border-color-inverse);
    }
    &-light {
      border-color: var(--tnw-border-color-opacity);
    }
    &-white {
      border-color: var(--tnw-white);
    }
    &-black {
      border-color: var(--tnw-black);
    }
    &-success {
      border-color: var(--tnw-success-color);
    }
    &-warning {
      border-color: var(--tnw-warning-color);
    }
    &-danger {
      border-color: var(--tnw-danger-color);
    }
    &-info {
      border-color: var(--tnw-info-color);
    }
  }
}

.tnw-directional-v {
  /*
    * none
    */
  &-none {
    border: 0 !important;
    background: none !important;
    padding: 0 !important;
  }

  /*
    * transparent
    */
  &-transparent {
    &-primary {
      color: var(--tnw-primary-color);
      fill: var(--tnw-primary-color);
    }
    &-secondary {
      color: var(--tnw-secondary-color);
      fill: var(--tnw-secondary-color);
    }
    &-auto {
      color: var(--tnw-text-color);
      fill: var(--tnw-text-color);
    }
    &-inverse {
      color: var(--tnw-text-color-inverse);
      fill: var(--tnw-text-color-inverse);
    }
    &-light {
      color: var(--tnw-text-color-light);
      fill: var(--tnw-text-color-light);
    }
    &-white {
      color: var(--tnw-white);
      fill: var(--tnw-white);
    }
    &-black {
      color: var(--tnw-black);
      fill: var(--tnw-black);
    }
  }

  /*
    * solid
    */
  &-solid {
    &-primary,
    &-secondary,
    &-black {
      color: var(--tnw-white);
      fill: var(--tnw-white);
    }

    &-light,
    &-auto {
      color: var(--tnw-text-color);
      fill: var(--tnw-text-color);
    }

    &-primary {
      background-color: var(--tnw-primary-color);
    }
    &-secondary {
      background-color: var(--tnw-secondary-color);
    }
    &-auto {
      background-color: var(--tnw-background-color);
    }
    &-inverse {
      background-color: var(--tnw-background-color-inverse);
      color: var(--tnw-text-color-inverse);
      fill: var(--tnw-text-color-inverse);
    }
    &-light {
      background-color: var(--tnw-background-color-secondry);
    }
    &-white {
      background-color: var(--tnw-white);
      color: var(--tnw-black);
      fill: var(--tnw-black);
    }
    &-black {
      background-color: var(--tnw-black);
    }
  }

  /*
    * Mixed
    */
  &-mixed {
    &-primary,
    &-secondary,
    &-black,
    &-white,
    &-light,
    &-auto {
      border-width: var(--tnw-border-sm);
      border-style: solid;
    }

    &-primary {
      background-color: var(--tnw-primary-color-100);
      border-color: var(--tnw-primary-color-200);
    }
    &-secondary {
      background-color: var(--tnw-secondary-color-100);
      border-color: var(--tnw-secondary-color-200);
    }
    &-auto {
      background-color: var(--tnw-background-color-100);
      border-color: var(--tnw-background-color-200);
    }
    &-inverse {
      background-color: var(--tnw-background-color-inverse-100);
      border-color: var(--tnw-background-color-inverse-200);
      color: var(--tnw-text-color-inverse);
      fill: var(--tnw-text-color-inverse);
    }
    &-light {
      background-color: var(--tnw-background-color-100);
      border-color: var(--tnw-background-color-200);
    }
    &-white {
      background-color: var(--tnw-gray-100);
      border-color: var(--tnw-gray-300);
    }
    &-black {
      background-color: var(--tnw-gray-800);
      border-color: var(--tnw-gray-900);
    }
  }

  /*
    * outline
    */
  &-outlined {
    &-primary,
    &-secondary,
    &-auto,
    &-inverse,
    &-light,
    &-white,
    &-black {
      border-width: var(--tnw-border-sm);
      border-style: solid;
    }

    &-primary {
      border-color: var(--tnw-primary-color);
    }
    &-secondary {
      border-color: var(--tnw-secondary-color);
    }
    &-auto {
      border-color: var(--tnw-border-color);
    }
    &-inverse {
      border-color: var(--tnw-border-color-inverse);
    }
    &-light {
      border-color: var(--tnw-border-color-opacity);
    }
    &-white {
      border-color: var(--tnw-white);
    }
    &-black {
      border-color: var(--tnw-black);
    }

    /* Outline-inline */
    &-inline {
      &-primary,
      &-secondary,
      &-auto,
      &-inverse,
      &-light,
      &-white,
      &-black {
        border-inline-width: var(--tnw-border-sm);
        border-inline-style: solid;
        color: var(--tnw-text-color);
        fill: var(--tnw-text-color);
        border-top: 0;
        border-bottom: 0;
      }

      &-primary {
        border-inline-color: var(--tnw-primary-color);
      }
      &-secondary {
        border-inline-color: var(--tnw-secondary-color);
      }
      &-auto {
        border-inline-color: var(--tnw-border-color);
      }
      &-inverse {
        border-inline-color: var(--tnw-border-color-inverse);
      }
      &-light {
        border-inline-color: var(--tnw-border-color-opacity);
      }
      &-white {
        border-inline-color: var(--tnw-white);
      }
      &-black {
        border-inline-color: var(--tnw-black);
      }
    }

    /* Outline-right */
    &-right {
      &-primary,
      &-secondary,
      &-auto,
      &-inverse,
      &-light,
      &-white,
      &-black {
        border-right-width: var(--tnw-border-sm);
        border-right-style: solid;
        color: var(--tnw-text-color);
        fill: var(--tnw-text-color);
        border-left: 0;
        border-top: 0;
        border-bottom: 0;
      }

      &-primary {
        border-right-color: var(--tnw-primary-color);
      }
      &-secondary {
        border-right-color: var(--tnw-secondary-color);
      }
      &-auto {
        border-right-color: var(--tnw-border-color);
      }
      &-inverse {
        border-right-color: var(--tnw-border-color-inverse);
      }
      &-light {
        border-right-color: var(--tnw-border-color-opacity);
      }
      &-white {
        border-right-color: var(--tnw-white);
      }
      &-black {
        border-right-color: var(--tnw-black);
      }
    }

    /* Outline-left */
    &-left {
      &-primary,
      &-secondary,
      &-auto,
      &-inverse,
      &-light,
      &-white,
      &-black {
        border-left-width: var(--tnw-border-sm);
        border-left-style: solid;
        color: var(--tnw-text-color);
        fill: var(--tnw-text-color);
        border-right: 0;
        border-top: 0;
        border-bottom: 0;
      }

      &-primary {
        border-left-color: var(--tnw-primary-color);
      }
      &-secondary {
        border-left-color: var(--tnw-secondary-color);
      }
      &-auto {
        border-left-color: var(--tnw-border-color);
      }
      &-inverse {
        border-left-color: var(--tnw-border-color-inverse);
      }
      &-light {
        border-left-color: var(--tnw-border-color-opacity);
      }
      &-white {
        border-left-color: var(--tnw-white);
      }
      &-black {
        border-left-color: var(--tnw-black);
      }
    }

    /* Outline-block */
    &-block {
      &-primary,
      &-secondary,
      &-auto,
      &-inverse,
      &-light,
      &-white,
      &-black {
        border-block-width: var(--tnw-border-sm);
        border-block-style: solid;
        color: var(--tnw-text-color);
        fill: var(--tnw-text-color);
        border-left: 0;
        border-right: 0;
      }

      &-primary {
        border-block-color: var(--tnw-primary-color);
      }
      &-secondary {
        border-block-color: var(--tnw-secondary-color);
      }
      &-auto {
        border-block-color: var(--tnw-border-color);
      }
      &-inverse {
        border-block-color: var(--tnw-border-color-inverse);
      }
      &-light {
        border-block-color: var(--tnw-border-color-opacity);
      }
      &-white {
        border-block-color: var(--tnw-white);
      }
      &-black {
        border-block-color: var(--tnw-black);
      }
    }

    /* Outline-bottom */
    &-bottom {
      &-primary,
      &-secondary,
      &-auto,
      &-inverse,
      &-light,
      &-white,
      &-black {
        border-bottom-width: var(--tnw-border-sm);
        border-bottom-style: solid;
        color: var(--tnw-text-color);
        fill: var(--tnw-text-color);
        border-top: 0;
        border-left: 0;
        border-right: 0;
      }

      &-primary {
        border-bottom-color: var(--tnw-primary-color);
      }
      &-secondary {
        border-bottom-color: var(--tnw-secondary-color);
      }
      &-auto {
        border-bottom-color: var(--tnw-border-color);
      }
      &-inverse {
        border-bottom-color: var(--tnw-border-color-inverse);
      }
      &-light {
        border-bottom-color: var(--tnw-border-color-opacity);
      }
      &-white {
        border-bottom-color: var(--tnw-white);
      }
      &-black {
        border-bottom-color: var(--tnw-black);
      }
    }

    /* Outline-top */
    &-top {
      &-primary,
      &-secondary,
      &-auto,
      &-inverse,
      &-light,
      &-white,
      &-black {
        border-top-width: var(--tnw-border-sm);
        border-top-style: solid;
        color: var(--tnw-text-color);
        fill: var(--tnw-text-color);
        border-bottom: 0;
        border-left: 0;
        border-right: 0;
      }

      &-primary {
        border-top-color: var(--tnw-primary-color);
      }
      &-secondary {
        border-top-color: var(--tnw-secondary-color);
      }
      &-auto {
        border-top-color: var(--tnw-border-color);
      }
      &-inverse {
        border-top-color: var(--tnw-border-color-inverse);
      }
      &-light {
        border-top-color: var(--tnw-border-color-opacity);
      }
      &-white {
        border-top-color: var(--tnw-white);
      }
      &-black {
        border-top-color: var(--tnw-black);
      }
    }
  }
}
