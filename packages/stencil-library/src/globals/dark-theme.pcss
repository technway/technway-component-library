html.dark-theme {
  /** 
   * Start: Override light theme colors 
   */
  --tnw-background-color: var(--background-color, #060606);
  --tnw-background-color-rgb: var(--background-color-rgb, 6, 6, 6);
  --tnw-background-color-100: var(--background-color-100, #171418);
  --tnw-background-color-200: var(--background-color-200, #323132);
  --tnw-background-color-opacity: var(--background-color-opacity, rgba(var(--tnw-background-color-rgb), 0.2));
  --tnw-background-color-inverse: var(--background-color-inverse, #ffffff);
  --tnw-background-color-inverse-rgb: var(--background-color-inverse-rgb, 255, 255, 255);
  --tnw-background-color-inverse-100: var(--background-color-inverse-100, #e9e9e9);
  --tnw-background-color-inverse-200: var(--background-color-inverse-200, #d8d8d8);

  --tnw-text-color: #fefefe;
  --tnw-text-color-light: var(--text-color-light, #eee);
  --tnw-text-color-inverse: var(--text-color-inverse, #0e0e0e);

  --tnw-placeholder-color: var(--placeholder-color, rgba(255, 255, 255, 0.75));

  --tnw-border-color: var(--border-color, #2d2d2d);
  --tnw-border-color-rgb: var(--border-color-rgb, #2d2d2d);
  --tnw-border-color-inverse: var(--border-color-inverse, #ccc);
  --tnw-border-color-inverse-rgb: var(--border-color-inverse-rgb, 204, 204, 204);
  --tnw-border-color-opacity: var(--border-color-opacity, rgba(255, 255, 255, 0.08));
  /** 
   * End: Override light theme colors 
   */

  color-scheme: dark;
}