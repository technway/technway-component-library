@import 'variables.pcss';
@import 'variables.defaults.pcss';
@import 'icons.pcss';
@import 'font-face.pcss';
@import 'components-appearance-utils.pcss';
@import 'utils/_border-radius.pcss';
@import 'utils/_colors.pcss';
@import 'utils/_layout.pcss';
@import 'utils/_spacing.pcss';

* {
  box-sizing: border-box;
  scroll-behavior: smooth;
}

.container {
  max-width: var(--tnw-container-max-width);
  width: var(--tnw-container-width);
  margin-left: auto;
  margin-right: auto;
}