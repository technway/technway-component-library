/**
 * tnw CSS Utilities
 *
 * Accessibility Utilities
 * 
 * This file provides utility classes for accessibility using the defined variables.
 */

/* Screen Reader Only */
.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

/* Keyboard Navigation */
.keyboard-only {
  &:focus {
    outline: 2px solid var(--tnw-focus-color);
    outline-offset: 2px;
  }
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  .reduced-motion {
    animation: none;
    transition: none;
  }
}
