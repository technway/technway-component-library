/* Gap Utilities */
@define-mixin gap $value {
  &-$value {
    gap: var(--tnw-spacing-$value);
  }
}
@define-mixin gap-column $value {
  &-col-$value {
    column-gap: var(--tnw-spacing-$value);
  }
}
@define-mixin gap-row $value {
  &-row-$value {
    row-gap: var(--tnw-spacing-$value);
  }
}
.gap {
  @mixin gap 2xs;
  @mixin gap xs;
  @mixin gap sm;
  @mixin gap md;
  @mixin gap lg;
  @mixin gap xl;
  @mixin gap 2xl;
  @mixin gap 3xl;
  @mixin gap 4xl;

  @mixin gap-column 2xs;
  @mixin gap-column xs;
  @mixin gap-column sm;
  @mixin gap-column md;
  @mixin gap-column lg;
  @mixin gap-column xl;
  @mixin gap-column 2xl;
  @mixin gap-column 3xl;
  @mixin gap-column 4xl;

  @mixin gap-row 2xs;
  @mixin gap-row xs;
  @mixin gap-row sm;
  @mixin gap-row md;
  @mixin gap-row lg;
  @mixin gap-row xl;
  @mixin gap-row 2xl;
  @mixin gap-row 3xl;
  @mixin gap-row 4xl;
}

/* Position Spacing Utilities */
@define-mixin top $value {
  &-$value {
    top: var(--tnw-spacing-$value);
  }
}
@define-mixin bottom $value {
  &-$value {
    bottom: var(--tnw-spacing-$value);
  }
}
@define-mixin left $value {
  &-$value {
    left: var(--tnw-spacing-$value);
  }
}
@define-mixin right $value {
  &-$value {
    right: var(--tnw-spacing-$value);
  }
}
@define-mixin inset $value {
  &-$value {
    inset: var(--tnw-spacing-$value);
  }
}

/* Apply Position Utilities */
.top {
  @mixin top 2xs;
  @mixin top xs;
  @mixin top sm;
  @mixin top md;
  @mixin top lg;
  @mixin top xl;
  @mixin top 2xl;
  @mixin top 3xl;
  @mixin top 4xl;
}
.bottom {
  @mixin bottom 2xs;
  @mixin bottom xs;
  @mixin bottom sm;
  @mixin bottom md;
  @mixin bottom lg;
  @mixin bottom xl;
  @mixin bottom 2xl;
  @mixin bottom 3xl;
  @mixin bottom 4xl;
}
.left {
  @mixin left 2xs;
  @mixin left xs;
  @mixin left sm;
  @mixin left md;
  @mixin left lg;
  @mixin left xl;
  @mixin left 2xl;
  @mixin left 3xl;
  @mixin left 4xl;
}
.right {
  @mixin right 2xs;
  @mixin right xs;
  @mixin right sm;
  @mixin right md;
  @mixin right lg;
  @mixin right xl;
  @mixin right 2xl;
  @mixin right 3xl;
  @mixin right 4xl;
}
.inset {
  @mixin inset 2xs;
  @mixin inset xs;
  @mixin inset sm;
  @mixin inset md;
  @mixin inset lg;
  @mixin inset xl;
  @mixin inset 2xl;
  @mixin inset 3xl;
  @mixin inset 4xl;
}
