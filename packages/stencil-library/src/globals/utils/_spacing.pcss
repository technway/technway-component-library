  @mixin padding-bottom sm;
  @mixin padding-bottom md;
  @mixin padding-bottom lg;
  @mixin padding-bottom xl;
  @mixin padding-bottom 2xl;
  @mixin padding-bottom 3xl;
  @mixin padding-bottom 4xl;

  @mixin padding-left 2xs;
  @mixin padding-left xs;
  @mixin padding-left sm;
  @mixin padding-left md;
  @mixin padding-left lg;
  @mixin padding-left xl;
  @mixin padding-left 2xl;
