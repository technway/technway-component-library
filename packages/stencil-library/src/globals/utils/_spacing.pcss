/**
 * tnw CSS Utilities
 *
 * Spacing Utilities
 * 
 * This file provides utility classes for margins, paddings, and gaps using the defined variables.
 */

/* Margin Utilities */
@define-mixin margin $value {
  &-$value {
    margin: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-top $value {
  &t-$value {
    margin-top: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-bottom $value {
  &b-$value {
    margin-bottom: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-right $value {
  &r-$value {
    margin-right: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-left $value {
  &l-$value {
    margin-left: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-inline $value {
  &inl-$value {
    margin-inline: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-inline-start $value {
  &inls-$value {
    margin-inline-start: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-inline-end $value {
  &inle-$value {
    margin-inline-end: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-block $value {
  &blk-$value {
    margin-block: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-block-start $value {
  &blks-$value {
    margin-block-start: var(--tnw-spacing-$value);
  }
}
@define-mixin margin-block-end $value {
  &blke-$value {
    margin-block-end: var(--tnw-spacing-$value);
  }
}
.m {
  @mixin margin 2xs;
  @mixin margin xs;
  @mixin margin sm;
  @mixin margin md;
  @mixin margin lg;
  @mixin margin xl;
  @mixin margin 2xl;
  @mixin margin 3xl;
  @mixin margin 4xl;
  @mixin margin auto;

  @mixin margin-top 2xs;
  @mixin margin-top xs;
  @mixin margin-top sm;
  @mixin margin-top md;
  @mixin margin-top lg;
  @mixin margin-top xl;
  @mixin margin-top 2xl;
  @mixin margin-top 3xl;
  @mixin margin-top 4xl;
  @mixin margin-top auto;

  @mixin margin-bottom 2xs;
  @mixin margin-bottom xs;
  @mixin margin-bottom sm;
  @mixin margin-bottom md;
  @mixin margin-bottom lg;
  @mixin margin-bottom xl;
  @mixin margin-bottom 2xl;
  @mixin margin-bottom 3xl;
  @mixin margin-bottom 4xl;
  @mixin margin-bottom auto;

  @mixin margin-left 2xs;
  @mixin margin-left xs;
  @mixin margin-left sm;
  @mixin margin-left md;
  @mixin margin-left lg;
  @mixin margin-left xl;
  @mixin margin-left 2xl;
  @mixin margin-left 3xl;
  @mixin margin-left 4xl;
  @mixin margin-left auto;

  @mixin margin-inline 2xs;
  @mixin margin-inline xs;
  @mixin margin-inline sm;
  @mixin margin-inline md;
  @mixin margin-inline lg;
  @mixin margin-inline xl;
  @mixin margin-inline 2xl;
  @mixin margin-inline 3xl;
  @mixin margin-inline 4xl;
  @mixin margin-inline auto;

  @mixin margin-inline-start 2xs;
  @mixin margin-inline-start xs;
  @mixin margin-inline-start sm;
  @mixin margin-inline-start md;
  @mixin margin-inline-start lg;
  @mixin margin-inline-start xl;
  @mixin margin-inline-start 2xl;
  @mixin margin-inline-start 3xl;
  @mixin margin-inline-start 4xl;
  @mixin margin-inline-start auto;

  @mixin margin-inline-end 2xs;
  @mixin margin-inline-end xs;
  @mixin margin-inline-end sm;
  @mixin margin-inline-end md;
  @mixin margin-inline-end lg;
  @mixin margin-inline-end xl;
  @mixin margin-inline-end 2xl;
  @mixin margin-inline-end 3xl;
  @mixin margin-inline-end 4xl;
  @mixin margin-inline-end auto;

  @mixin margin-block 2xs;
  @mixin margin-block xs;
  @mixin margin-block sm;
  @mixin margin-block md;
  @mixin margin-block lg;
  @mixin margin-block xl;
  @mixin margin-block 2xl;
  @mixin margin-block 3xl;
  @mixin margin-block 4xl;
  @mixin margin-block auto;

  @mixin margin-block-start 2xs;
  @mixin margin-block-start xs;
  @mixin margin-block-start sm;
  @mixin margin-block-start md;
  @mixin margin-block-start lg;
  @mixin margin-block-start xl;
  @mixin margin-block-start 2xl;
  @mixin margin-block-start 3xl;
  @mixin margin-block-start 4xl;
  @mixin margin-block-start auto;

  @mixin margin-block-end 2xs;
  @mixin margin-block-end xs;
  @mixin margin-block-end sm;
  @mixin margin-block-end md;
  @mixin margin-block-end lg;
  @mixin margin-block-end xl;
  @mixin margin-block-end 2xl;
  @mixin margin-block-end 3xl;
  @mixin margin-block-end 4xl;
  @mixin margin-block-end auto;
}

/* Padding Utilities */
@define-mixin padding $value {
